# Free Gemini key from https://aistudio.google.com/apikey in a project with NO billing
# account, so it can never be charged (it returns 429 when the daily quota is used up)
GEMINI_API_KEY=your-free-tier-gemini-key
# Optional: override the model (check AI Studio's rate-limit page for free-tier models)
# Defaults: gemini-flash-latest, falling back to gemini-flash-lite-latest when overloaded
GEMINI_MODEL=gemini-flash-latest
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
# Shared secret the crawler sends as X-Crawler-Key (any long random string)
CRAWLER_API_KEY=generate-a-long-random-string
# OAuth apps; callback URLs: http://localhost:8080/login/oauth2/code/github and .../google
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional: raises GitHub API rate limits for tech discovery (no scopes needed)
GITHUB_TOKEN=
